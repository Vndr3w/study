apiVersion: v1
clusters:
- cluster:
    certificate-authority-data: 
    server: https://127.0.0.1:16443
  name: microk8s
contexts:
- context:
    cluster: microk8s
    namespace: config-access
    user: developer
  name: developer@microk8s
current-context: developer@microk8s
kind: Config
users:
- name: developer
  user:
    client-certificate-data: 
    client-key-data: 
